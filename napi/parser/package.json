{
  "name": "@swc-next/parser",
  "version": "0.1.1",
  "description": "The focused JavaScript and TypeScript parser for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "napi/parser"
  },
  "main": "src-js/index.js",
  "type": "module",
  "types": "./src-js/index.d.ts",
  "exports": {
    ".": {
      "import": "./src-js/index.js",
      "types": "./src-js/index.d.ts"
    }
  },
  "files": [
    "src-js/binding.d.ts",
    "src-js/binding.js",
    "src-js/decode.js",
    "src-js/index.d.ts",
    "src-js/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --esm --platform --js binding.js --dts binding.d.ts --output-dir src-js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "ast",
    "javascript",
    "parser",
    "swc",
    "typescript"
  ],
  "license": "Apache-2.0",
  "napi": {
    "binaryName": "swc-next-parser",
    "packageName": "@swc-next/parser-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:"
  }
}
