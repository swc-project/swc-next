{
  "name": "@swc-exp/parser",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm build:rs && pnpm build:js",
    "build:js": "rslib build --entry src-js/index.ts --dts --clean",
    "build:rs": "napi build --esm --platform --js binding.js --dts binding.d.ts",
    "build:rs:release": "napi build --esm --platform --js binding.js --dts binding.d.ts --release",
    "test": "rstest --root src-js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@rslib/core": "catalog:",
    "@rstest/core": "catalog:",
    "@swc/core": "catalog:",
    "tinybench": "catalog:",
    "yuku-parser": "catalog:"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "napi": {
    "binaryName": "parser",
    "packageName": "@swc-exp/binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "dependencies": {
    "typescript": "catalog:"
  }
}
