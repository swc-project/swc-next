{
  "name": "@swc-next/core",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "napi build --esm --platform --js binding.js --dts binding.d.ts --output-dir src-js",
    "build:release": "pnpm build:rs --release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.12.0",
      "onFail": "download"
    }
  },
  "napi": {
    "binaryName": "swc-next",
    "packageName": "@swc-next/binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "dependencies": {
    "@napi-rs/cli": "catalog:"
  }
