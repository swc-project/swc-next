---------- Input ----------
[/* value */ first, /* another */ last];
---------- Options ----------
{"indentStyle":"space","lineWidth":80}
---------- Output ----------
[/* value */ first, /* another */ last];

---------- Options ----------
{"indentStyle":"space","lineWidth":14}
---------- Output ----------
[
  /* value */ first,
  /* another */ last,
];

---------- Options ----------
{"indentStyle":"space","lineWidth":13}
---------- Output ----------
[
  /* value */ first,
  /* another */ last,
];

---------- Options ----------
{"indentStyle":"space","lineWidth":10}
---------- Output ----------
[
  /* value */ first,
  /* another */ last,
];

---------- Options ----------
{"indentStyle":"space","lineWidth":0}
---------- Output ----------
[
  /* value */ first,
  /* another */ last,
];

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"semicolons":"as-needed"}
---------- Output ----------
;[/* value */ first, /* another */ last]

---------- Options ----------
{"indentStyle":"space","lineWidth":10,"trailingCommas":"none"}
---------- Output ----------
[
  /* value */ first,
  /* another */ last
];

---------- Options ----------
{"indentStyle":"space","lineWidth":10,"trailingCommas":"es5"}
---------- Output ----------
[
  /* value */ first,
  /* another */ last,
];

---------- Options ----------
{"indentStyle":"tab","indentWidth":4,"lineWidth":10}
---------- Output ----------
[
	/* value */ first,
	/* another */ last,
];

---------- Options ----------
{"indentStyle":"space","lineEnding":"crlf","lineWidth":10}
---------- Output ----------
[
  /* value */ first,
  /* another */ last,
];
