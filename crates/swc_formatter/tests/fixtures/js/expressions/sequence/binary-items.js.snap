---------- Input ----------
(firstLong + secondLong, thirdLong + fourthLong);
---------- Options ----------
{"indentStyle":"space","lineWidth":80}
---------- Output ----------
(firstLong + secondLong, thirdLong + fourthLong);

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"semicolons":"as-needed"}
---------- Output ----------
;(firstLong + secondLong, thirdLong + fourthLong)

---------- Options ----------
{"indentStyle":"space","lineWidth":20}
---------- Output ----------
(firstLong +
  secondLong,
  thirdLong +
    fourthLong);

---------- Options ----------
{"indentStyle":"space","lineWidth":8}
---------- Output ----------
(firstLong +
  secondLong,
  thirdLong +
    fourthLong);

---------- Options ----------
{"indentStyle":"space","indentWidth":4,"lineWidth":20}
---------- Output ----------
(firstLong +
    secondLong,
    thirdLong +
        fourthLong);

---------- Options ----------
{"indentStyle":"tab","indentWidth":4,"lineWidth":20}
---------- Output ----------
(firstLong +
	secondLong,
	thirdLong +
		fourthLong);

---------- Options ----------
{"indentStyle":"space","indentWidth":1,"lineWidth":20}
---------- Output ----------
(firstLong +
 secondLong,
 thirdLong +
  fourthLong);

---------- Options ----------
{"indentStyle":"space","lineEnding":"crlf","lineWidth":80}
---------- Output ----------
(firstLong + secondLong, thirdLong + fourthLong);
