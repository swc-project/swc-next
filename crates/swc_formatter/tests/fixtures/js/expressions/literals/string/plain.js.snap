source: crates/swc_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
['plain', "plain", 'don\'t', '"double"'];
---------- Options ----------
{"indentStyle":"space","lineWidth":80}
---------- Output ----------
["plain", "plain", "don't", '"double"'];

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"quoteStyle":"single"}
---------- Output ----------
['plain', 'plain', "don't", '"double"'];

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"semicolons":"as-needed"}
---------- Output ----------
;["plain", "plain", "don't", '"double"']

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"quoteStyle":"single","semicolons":"as-needed"}
---------- Output ----------
;['plain', 'plain', "don't", '"double"']

---------- Options ----------
{"indentStyle":"space","lineWidth":20}
---------- Output ----------
[
  "plain",
  "plain",
  "don't",
  '"double"',
];

---------- Options ----------
{"indentStyle":"space","lineWidth":10}
---------- Output ----------
[
  "plain",
  "plain",
  "don't",
  '"double"',
];

---------- Options ----------
{"indentStyle":"space","lineEnding":"crlf","lineWidth":80}
---------- Output ----------
["plain", "plain", "don't", '"double"'];

---------- Options ----------
{"indentStyle":"space","lineEnding":"cr","lineWidth":80}
---------- Output ----------
["plain", "plain", "don't", '"double"'];
---------- Options ----------
{"indentStyle":"tab","indentWidth":4,"lineWidth":10}
---------- Output ----------
[
	"plain",
	"plain",
	"don't",
	'"double"',
];
