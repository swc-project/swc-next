---------- Input ----------
first + /** @type {number} */ (second + third);
---------- Options ----------
{"indentStyle":"space","lineWidth":80}
---------- Output ----------
first + /** @type {number} */ (second + third);

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"semicolons":"as-needed"}
---------- Output ----------
first + /** @type {number} */ (second + third)

---------- Options ----------
{"indentStyle":"space","lineWidth":40}
---------- Output ----------
first +
  /** @type {number} */ (
    second + third
  );

---------- Options ----------
{"indentStyle":"space","lineWidth":20}
---------- Output ----------
first +
  /** @type {number} */ (
    second + third
  );

---------- Options ----------
{"indentStyle":"space","lineWidth":10}
---------- Output ----------
first +
  /** @type {number} */ (
    second +
      third
  );

---------- Options ----------
{"indentStyle":"tab","indentWidth":4,"lineWidth":20}
---------- Output ----------
first +
	/** @type {number} */ (
		second +
			third
	);

---------- Options ----------
{"indentStyle":"space","lineEnding":"crlf","lineWidth":80}
---------- Output ----------
first + /** @type {number} */ (second + third);

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"quoteStyle":"single"}
---------- Output ----------
first + /** @type {number} */ (second + third);
