---
source: crates/swc_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first && /* before */ [1, 2, 3, 4, 5];
---------- Options ----------
{"indentStyle":"space","lineWidth":80}
---------- Output ----------
first && /* before */ [1, 2, 3, 4, 5];

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"semicolons":"as-needed"}
---------- Output ----------
first && /* before */ [1, 2, 3, 4, 5]

---------- Options ----------
{"indentStyle":"space","lineWidth":20}
---------- Output ----------
first && /* before */ [
  1, 2, 3, 4, 5,
];

---------- Options ----------
{"indentStyle":"space","lineWidth":10}
---------- Output ----------
first && /* before */ [
  1, 2, 3,
  4, 5,
];

---------- Options ----------
{"indentStyle":"tab","indentWidth":4,"lineWidth":20}
---------- Output ----------
first && /* before */ [
	1, 2, 3, 4, 5,
];

---------- Options ----------
{"indentStyle":"space","lineEnding":"crlf","lineWidth":80}
---------- Output ----------
first && /* before */ [1, 2, 3, 4, 5];

---------- Options ----------
{"indentStyle":"space","lineWidth":80,"quoteStyle":"single"}
---------- Output ----------
first && /* before */ [1, 2, 3, 4, 5];
