---------- Input ----------
switch (a) {
  case 1: /* first */
    // second
    { c(); }
}
---------- Options ----------
{"indentStyle":"space","lineWidth":80}
---------- Output ----------
switch (a) {
  case 1: /* first */ // second
  {
    c();
  }
}

---------- Options ----------
{"indentStyle":"space","lineWidth":20,"semicolons":"as-needed"}
---------- Output ----------
switch (a) {
  case 1: /* first */ // second
  {
    c()
  }
}

---------- Options ----------
{"indentStyle":"tab","lineWidth":80,"trailingCommas":"none"}
---------- Output ----------
switch (a) {
	case 1: /* first */ // second
	{
		c();
	}
}

---------- Options ----------
{"indentStyle":"space","lineEnding":"crlf","lineWidth":1,"semicolons":"as-needed"}
---------- Output ----------
switch (
  a
) {
  case 1: /* first */ // second
  {
    c()
  }
}
