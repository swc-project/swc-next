---------- Input ----------
_ = `${
firstLongName || secondLongName || thirdLongName
}`;
---------- Options ----------
{"printWidth":80}
---------- Output ----------
_ = `${firstLongName || secondLongName || thirdLongName}`;

---------- Options ----------
{"printWidth":20,"semi":false,"trailingComma":"none"}
---------- Output ----------
_ = `${
  firstLongName ||
  secondLongName ||
  thirdLongName
}`

---------- Options ----------
{"endOfLine":"crlf","printWidth":40}
---------- Output ----------
_ = `${
  firstLongName ||
  secondLongName ||
  thirdLongName
}`;
