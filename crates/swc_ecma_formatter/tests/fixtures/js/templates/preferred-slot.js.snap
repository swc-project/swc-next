---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
const value = `start ${[[first, second], [third, fourth]]} end`;
---------- Options ----------
{"printWidth":80}
---------- Output ----------
const value = `start ${[
  [first, second],
  [third, fourth],
]} end`;

---------- Options ----------
{"printWidth":20,"semi":false,"trailingComma":"none"}
---------- Output ----------
const value = `start ${[
  [first, second],
  [third, fourth]
]} end`

---------- Options ----------
{"endOfLine":"crlf","printWidth":40}
---------- Output ----------
const value = `start ${[
  [first, second],
  [third, fourth],
]} end`;
