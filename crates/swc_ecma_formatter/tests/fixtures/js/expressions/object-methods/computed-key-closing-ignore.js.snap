---------- Input ----------
({[first+second /* prettier-ignore */]: third+fourth});
---------- Options ----------
{}
---------- Output ----------
({ [first+second /* prettier-ignore */]: third + fourth });

---------- Options ----------
{"printWidth":20}
---------- Output ----------
({
  [
    first+second /* prettier-ignore */]:
    third + fourth,
});

---------- Options ----------
{"printWidth":1,"semi":false,"trailingComma":"none"}
---------- Output ----------
;({
  [
    first+second /* prettier-ignore */]:
    third +
    fourth
})

---------- Options ----------
{"bracketSpacing":false,"printWidth":40,"semi":false}
---------- Output ----------
;({
  [first+second /* prettier-ignore */]:
    third + fourth,
})
