{"printWidth":20}
---------- Output ----------
({
  "method"
  /* prettier-ignore */
  (first=1+2, second=3+4) { return first+second; },
});

---------- Options ----------
{"printWidth":1,"semi":false,"trailingComma":"none"}
---------- Output ----------
