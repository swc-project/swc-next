---------- Input ----------
({ "method"
/* prettier-ignore */
(first=1+2, second=3+4) { return first+second; } });
---------- Options ----------
{}
---------- Output ----------
({
  "method"
  /* prettier-ignore */
  (first=1+2, second=3+4) { return first+second; },
});

