---------- Input ----------
({ get [key]() { return value; }, set [key](value) { target(value); } });
---------- Options ----------
{}
---------- Output ----------
({
  get [key]() {
    return value;
  },
  set [key](value) {
    target(value);
  },
});

---------- Options ----------
{"printWidth":20}
---------- Output ----------
({
  get [key]() {
    return value;
  },
  set [key](value) {
    target(value);
  },
});

---------- Options ----------
{"printWidth":1,"semi":false,"trailingComma":"none"}
---------- Output ----------
;({
  get [key]() {
    return value
  },
  set [key](
    value
  ) {
    target(
      value
    )
  }
})

---------- Options ----------
{"bracketSpacing":false,"printWidth":40,"semi":false}
---------- Output ----------
;({
  get [key]() {
    return value
  },
  set [key](value) {
    target(value)
  },
})
