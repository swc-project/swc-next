source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
(/* @__PURE__ */ [1, 2, 3, 4, 5]);
---------- Options ----------
{}
---------- Output ----------
(/* @__PURE__ */ [1, 2, 3, 4, 5]);

---------- Options ----------
{"semi":false}
---------- Output ----------
;(/* @__PURE__ */ [1, 2, 3, 4, 5])

---------- Options ----------
{"printWidth":20}
---------- Output ----------
(/* @__PURE__ */ [
    1, 2, 3, 4, 5,
  ]
);

---------- Options ----------
{"printWidth":10}
---------- Output ----------
(/* @__PURE__ */ [
    1, 2,
    3, 4,
    5,
  ]
);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(/* @__PURE__ */ [
		1, 2, 3, 4,
		5,
	]
);

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
(/* @__PURE__ */ [1, 2, 3, 4, 5]);
