---------- Input ----------
(/* @__PURE__ */ first + second) * third;
---------- Options ----------
{}
---------- Output ----------
(/* @__PURE__ */ first + second) * third;

---------- Options ----------
{"semi":false}
---------- Output ----------
;(/* @__PURE__ */ first + second) * third

---------- Options ----------
{"printWidth":20}
---------- Output ----------
(/* @__PURE__ */ first +
  second
) * third;

---------- Options ----------
{"printWidth":10}
---------- Output ----------
(/* @__PURE__ */ first +
  second
) * third;

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(/* @__PURE__ */ first +
	second
) * third;

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
(/* @__PURE__ */ first + second) * third;
