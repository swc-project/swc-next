---------- Options ----------
{"printWidth":20}
---------- Output ----------
callee({
  first: 1,
  second: 2,
  third: 3,
});

---------- Options ----------
{"printWidth":80}
---------- Output ----------
callee({ first: 1, second: 2, third: 3 });

---------- Options ----------
{"printWidth":20,"semi":false}
