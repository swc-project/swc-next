---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
[-1,+2,-3,+4,-5,+6,-7,+8];
---------- Options ----------
{}
---------- Output ----------
[-1, +2, -3, +4, -5, +6, -7, +8];

---------- Options ----------
{"semi":false}
---------- Output ----------
;[-1, +2, -3, +4, -5, +6, -7, +8]

---------- Options ----------
{"printWidth":20}
---------- Output ----------
[
  -1, +2, -3, +4,
  -5, +6, -7, +8,
];

---------- Options ----------
{"printWidth":10}
---------- Output ----------
[
  -1, +2,
  -3, +4,
  -5, +6,
  -7, +8,
];

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
[
	-1, +2, -3, +4,
	-5, +6, -7, +8,
];

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
[-1, +2, -3, +4, -5, +6, -7, +8];

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
[-1, +2, -3, +4, -5, +6, -7, +8];
