!(
  /* before */ ~(
    /* inner */ item
  ) /* after */
);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
!(
	/* before */ ~(
		/* inner */ item
	) /* after */
);

---------- Options ----------
{"endOfLine":"crlf"}
