---------- Input ----------
(
/* before */
first * second) + third;
---------- Options ----------
{}
---------- Output ----------
/* before */
first * second + third;

---------- Options ----------
{"semi":false}
---------- Output ----------
/* before */
first * second + third

---------- Options ----------
{"printWidth":20}
---------- Output ----------
/* before */
first * second +
  third;

---------- Options ----------
{"printWidth":10}
---------- Output ----------
/* before */
first *
  second +
  third;

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
/* before */
first * second +
	third;

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
/* before */
first * second + third;

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
/* before */
first * second + third;
