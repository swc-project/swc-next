---------- Input ----------
([first, second]);
---------- Options ----------
{}
---------- Output ----------
[first, second];

---------- Options ----------
{"semi":false}
---------- Output ----------
;[first, second]

---------- Options ----------
{"printWidth":20}
---------- Output ----------
[first, second];

---------- Options ----------
{"printWidth":10}
---------- Output ----------
[
  first,
  second,
];

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
[first, second];

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
[first, second];

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
[first, second];
