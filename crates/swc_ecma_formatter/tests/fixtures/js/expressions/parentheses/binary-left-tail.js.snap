---------- Input ----------
(first + second /* after */) + third;
---------- Options ----------
{}
---------- Output ----------
first + second /* after */ + third;

---------- Options ----------
{"semi":false}
---------- Output ----------
first + second /* after */ + third

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first +
  second /* after */ +
  third;

---------- Options ----------
{"printWidth":10}
---------- Output ----------
first +
  second /* after */ +
  third;

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first +
	second /* after */ +
	third;

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first + second /* after */ + third;

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
first + second /* after */ + third;
