---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first * (/* before */ second + third);
---------- Options ----------
{}
---------- Output ----------
first * /* before */ (second + third);

---------- Options ----------
{"semi":false}
---------- Output ----------
first * /* before */ (second + third)

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first *
  /* before */ (second +
    third);

---------- Options ----------
{"printWidth":10}
---------- Output ----------
first *
  /* before */ (second +
    third);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first *
	/* before */ (second +
		third);

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first * /* before */ (second + third);

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
first * /* before */ (second + third);
