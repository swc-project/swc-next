---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first + (second + third /* after */);
---------- Options ----------
{}
---------- Output ----------
first + (second + third); /* after */

---------- Options ----------
{"semi":false}
---------- Output ----------
first + (second + third) /* after */

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first +
  (second +
    third); /* after */

---------- Options ----------
{"printWidth":10}
---------- Output ----------
first +
  (second +
    third); /* after */

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first +
	(second +
		third); /* after */

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first + (second + third); /* after */

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
first + (second + third); /* after */
