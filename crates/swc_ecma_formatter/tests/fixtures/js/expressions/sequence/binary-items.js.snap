---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
(firstLong + secondLong, thirdLong + fourthLong);
---------- Options ----------
{}
---------- Output ----------
(firstLong + secondLong, thirdLong + fourthLong);

---------- Options ----------
{"semi":false}
---------- Output ----------
;(firstLong + secondLong, thirdLong + fourthLong)

---------- Options ----------
{"printWidth":20}
---------- Output ----------
(firstLong +
  secondLong,
  thirdLong +
    fourthLong);

---------- Options ----------
{"printWidth":8}
---------- Output ----------
(firstLong +
  secondLong,
  thirdLong +
    fourthLong);

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
(firstLong +
    secondLong,
    thirdLong +
        fourthLong);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(firstLong +
	secondLong,
	thirdLong +
		fourthLong);

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
(firstLong +
 secondLong,
 thirdLong +
  fourthLong);

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
(firstLong + secondLong, thirdLong + fourthLong);
