source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first, /** @type {number} */ third = fourth;
---------- Options ----------
{}
---------- Output ----------
(first, (/** @type {number} */ third = fourth));

---------- Options ----------
{"semi":false}
---------- Output ----------
;(first, (/** @type {number} */ third = fourth))

---------- Options ----------
{"printWidth":20}
---------- Output ----------
(first,
  (
    /** @type {number} */ third =
      fourth
  ));

---------- Options ----------
{"printWidth":8}
---------- Output ----------
(first,
  (
    /** @type {number} */ third =
      fourth
  ));

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
(first,
    (
        /** @type {number} */ third =
            fourth
    ));

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(first,
	(
		/** @type {number} */ third =
			fourth
	));

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
(first,
 (
  /** @type {number} */ third =
   fourth
 ));

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
(first, (/** @type {number} */ third = fourth));
