---------- Input ----------
(// prettier-ignore
first+second, third);
---------- Options ----------
{}
---------- Output ----------
(// prettier-ignore
  first+second, third
);

---------- Options ----------
{"semi":false}
---------- Output ----------
;(// prettier-ignore
  first+second, third
)

---------- Options ----------
{"printWidth":20}
---------- Output ----------
(// prettier-ignore
  first+second, third
);

---------- Options ----------
{"printWidth":8}
---------- Output ----------
(// prettier-ignore
  first+second, third
);

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
(// prettier-ignore
    first+second, third
);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(// prettier-ignore
	first+second, third
);

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
(// prettier-ignore
 first+second, third
);

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
(// prettier-ignore
  first+second, third
);
