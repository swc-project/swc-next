---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first = second
/* before */
, /** @type {number} */ third = fourth;
---------- Options ----------
{}
---------- Output ----------
((first = second), (/* before */ /** @type {number} */ third = fourth));

---------- Options ----------
{"semi":false}
---------- Output ----------
;((first = second), (/* before */ /** @type {number} */ third = fourth))

---------- Options ----------
{"printWidth":20}
---------- Output ----------
((first = second),
  (
    /* before */ /** @type {number} */ third =
      fourth
  ));

---------- Options ----------
{"printWidth":8}
---------- Output ----------
((first =
  second),
  (
    /* before */ /** @type {number} */ third =
      fourth
  ));

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
((first = second),
    (
        /* before */ /** @type {number} */ third =
            fourth
    ));

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
((first = second),
	(
		/* before */ /** @type {number} */ third =
			fourth
	));

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
((first = second),
 (
  /* before */ /** @type {number} */ third =
   fourth
 ));

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
((first = second), (/* before */ /** @type {number} */ third = fourth));
