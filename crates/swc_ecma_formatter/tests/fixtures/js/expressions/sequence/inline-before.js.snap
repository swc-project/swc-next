first /* before */, second;
---------- Options ----------
{}
---------- Output ----------
(first /* before */, second);

---------- Options ----------
{"semi":false}
---------- Output ----------
;(first /* before */, second)

---------- Options ----------
{"printWidth":20}
---------- Output ----------
(first /* before */,
  second);

---------- Options ----------
{"printWidth":8}
---------- Output ----------
(first /* before */,
  second);

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
(first /* before */,
    second);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(first /* before */,
	second);

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
(first /* before */,
 second);

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
(first /* before */, second);
