---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first && second && [1, 2, 3, 4, 5];
---------- Options ----------
{}
---------- Output ----------
first && second && [1, 2, 3, 4, 5];

---------- Options ----------
{"semi":false}
---------- Output ----------
first && second && [1, 2, 3, 4, 5]

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first &&
  second && [
    1, 2, 3, 4, 5,
  ];

---------- Options ----------
{"printWidth":10}
---------- Output ----------
first &&
  second && [
    1, 2,
    3, 4,
    5,
  ];

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first &&
	second && [
		1, 2, 3, 4,
		5,
	];

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first && second && [1, 2, 3, 4, 5];

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
first && second && [1, 2, 3, 4, 5];
