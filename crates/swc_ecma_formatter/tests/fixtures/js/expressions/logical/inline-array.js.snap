source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first && [1, 2, 3, 4, 5];
---------- Options ----------
{}
---------- Output ----------
first && [1, 2, 3, 4, 5];

---------- Options ----------
{"semi":false}
---------- Output ----------
first && [1, 2, 3, 4, 5]

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first && [
  1, 2, 3, 4, 5,
];

---------- Options ----------
{"printWidth":10}
---------- Output ----------
first && [
  1, 2, 3,
  4, 5,
];

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first && [
	1, 2, 3, 4, 5,
];

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first && [1, 2, 3, 4, 5];

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
first && [1, 2, 3, 4, 5];
