{"printWidth":20}
---------- Output ----------
(a) =>
  (
    b,
  ) => (/* prettier-ignore */)=>a+b;

---------- Options ----------
{"printWidth":1}
---------- Output ----------
(
    a,
  ) =>
  (
    b,
  ) => (/* prettier-ignore */)=>a+b;

---------- Options ----------
{"printWidth":20,"semi":false,"trailingComma":"none"}
