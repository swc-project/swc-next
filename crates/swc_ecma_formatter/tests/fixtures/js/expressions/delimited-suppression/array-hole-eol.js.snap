---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
[a+b,, /* prettier-ignore */
c+d];
---------- Options ----------
{}
---------- Output ----------
[
  a+b,, /* prettier-ignore */
  c + d,
];

---------- Options ----------
{"printWidth":20}
---------- Output ----------
[
  a+b,, /* prettier-ignore */
  c + d,
];

---------- Options ----------
{"printWidth":1}
---------- Output ----------
[
  a+b,, /* prettier-ignore */
  c +
    d,
];

---------- Options ----------
{"printWidth":20,"semi":false,"trailingComma":"none"}
---------- Output ----------
;[
  a+b,, /* prettier-ignore */
  c + d
]

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
[
	a+b,, /* prettier-ignore */
	c + d,
];
