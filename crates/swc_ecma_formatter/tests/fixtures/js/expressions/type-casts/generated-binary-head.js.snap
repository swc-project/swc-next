---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
((/** @type {number} */ first || second) + third) * fourth;
---------- Options ----------
{}
---------- Output ----------
/** @type {number} */ ((first || second) + third) * fourth;

---------- Options ----------
{"semi":false}
---------- Output ----------
;/** @type {number} */ ((first || second) + third) * fourth

---------- Options ----------
{"printWidth":40}
---------- Output ----------
/** @type {number} */ (
  (first || second) + third
) * fourth;

---------- Options ----------
{"printWidth":20}
---------- Output ----------
/** @type {number} */ (
  (first ||
    second) + third
) * fourth;

---------- Options ----------
{"printWidth":10}
---------- Output ----------
/** @type {number} */ (
  (first ||
    second) +
    third
) *
  fourth;

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
/** @type {number} */ (
	(first ||
		second) +
		third
) * fourth;

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
/** @type {number} */ ((first || second) + third) * fourth;

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
/** @type {number} */ ((first || second) + third) * fourth;
