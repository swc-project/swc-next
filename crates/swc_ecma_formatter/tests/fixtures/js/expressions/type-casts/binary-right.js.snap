---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first + /** @type {number} */ (second + third);
---------- Options ----------
{}
---------- Output ----------
first + /** @type {number} */ (second + third);

---------- Options ----------
{"semi":false}
---------- Output ----------
first + /** @type {number} */ (second + third)

---------- Options ----------
{"printWidth":40}
---------- Output ----------
first +
  /** @type {number} */ (
    second + third
  );

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first +
  /** @type {number} */ (
    second + third
  );

---------- Options ----------
{"printWidth":10}
---------- Output ----------
first +
  /** @type {number} */ (
    second +
      third
  );

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first +
	/** @type {number} */ (
		second +
			third
	);

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first + /** @type {number} */ (second + third);

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
first + /** @type {number} */ (second + third);
