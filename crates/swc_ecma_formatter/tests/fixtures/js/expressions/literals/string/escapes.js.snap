---------- Input ----------
['a\nb', "\'\"", 'a\\b', '\x61', "\u{1F600}", '\z'];
---------- Options ----------
{}
---------- Output ----------
["a\nb", "\'\"", "a\\b", "\x61", "\u{1F600}", "\z"];

---------- Options ----------
{"singleQuote":true}
