---------- Output ----------
({
  [a]: /*x*/
  /* prettier-ignore */
  [ 1,2 ],
});

---------- Options ----------
{"printWidth":80}
---------- Output ----------
({
  [a]: /*x*/
  /* prettier-ignore */
  [ 1,2 ],
});

