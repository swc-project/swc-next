---------- Input ----------
test ? (first, second // inside
) /** @type {number} */ : (left, right);
---------- Options ----------
{}
---------- Output ----------
test
  ? (first, second) // inside
  : /** @type {number} */ (left, right);

---------- Options ----------
{"semi":false}
---------- Output ----------
test
  ? (first, second) // inside
  : /** @type {number} */ (left, right)

---------- Options ----------
{"printWidth":20}
---------- Output ----------
test
  ? (first, second) // inside
  : /** @type {number} */ (
      left, right
    );

---------- Options ----------
{"printWidth":8}
---------- Output ----------
test
  ? (first,
    second) // inside
  : /** @type {number} */ (
      left,
      right
    );

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
test
    ? (first,
      second) // inside
    : /** @type {number} */ (
          left,
          right
      );

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
test
	? (first,
		second) // inside
	: /** @type {number} */ (
			left,
			right
		);

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
test
 ? (first, second) // inside
 : /** @type {number} */ (
    left, right
   );

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
test
  ? (first, second) // inside
  : /** @type {number} */ (left, right);
