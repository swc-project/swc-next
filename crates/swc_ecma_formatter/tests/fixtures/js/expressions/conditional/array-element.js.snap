[
	conditionLong
		? consequentLong
		: alternateLong,
];

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
[
 conditionLong
  ? consequentLong
  : alternateLong,
];

---------- Options ----------
{"endOfLine":"crlf"}
