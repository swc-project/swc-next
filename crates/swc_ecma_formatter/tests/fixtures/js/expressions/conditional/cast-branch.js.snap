---------- Input ----------
first ? (/** @type {number} */ (secondLong + thirdLong)) : fourth;
---------- Options ----------
{}
---------- Output ----------
first ? /** @type {number} */ (secondLong + thirdLong) : fourth;

---------- Options ----------
{"semi":false}
---------- Output ----------
first ? /** @type {number} */ (secondLong + thirdLong) : fourth

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first
  ? /** @type {number} */ (
      secondLong +
        thirdLong
    )
  : fourth;

---------- Options ----------
{"printWidth":8}
---------- Output ----------
first
  ? /** @type {number} */ (
      secondLong +
        thirdLong
    )
  : fourth;

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
first
    ? /** @type {number} */ (
          secondLong +
              thirdLong
      )
    : fourth;

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first
	? /** @type {number} */ (
			secondLong +
				thirdLong
		)
	: fourth;

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
first
 ? /** @type {number} */ (
    secondLong +
     thirdLong
   )
 : fourth;

---------- Options ----------
{"endOfLine":"crlf"}
