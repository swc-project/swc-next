---------- Input ----------
first
?
// before consequent
second
:
// before alternate
third;
---------- Options ----------
{}
---------- Output ----------
first
  ? // before consequent
    second
  : // before alternate
    third;

---------- Options ----------
{"semi":false}
---------- Output ----------
first
  ? // before consequent
    second
  : // before alternate
    third

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first
  ? // before consequent
    second
  : // before alternate
    third;

---------- Options ----------
{"printWidth":8}
---------- Output ----------
first
  ? // before consequent
    second
  : // before alternate
    third;

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
first
    ? // before consequent
      second
    : // before alternate
      third;

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first
	? // before consequent
		second
	: // before alternate
		third;

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
first
 ? // before consequent
   second
 : // before alternate
   third;

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first
  ? // before consequent
    second
  : // before alternate
    third;
