source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
target = // after
[first, second];
---------- Options ----------
{}
---------- Output ----------
target =
  // after
  [first, second];

---------- Options ----------
{"semi":false}
---------- Output ----------
target =
  // after
  [first, second]

---------- Options ----------
{"printWidth":20}
---------- Output ----------
target =
  // after
  [first, second];

---------- Options ----------
{"printWidth":8}
---------- Output ----------
target =
  // after
  [
    first,
    second,
  ];

---------- Options ----------
{"printWidth":20,"tabWidth":4}
---------- Output ----------
target =
    // after
    [first, second];

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
target =
	// after
	[first, second];

---------- Options ----------
{"printWidth":20,"tabWidth":1}
---------- Output ----------
target =
 // after
 [first, second];

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
target =
  // after
  [first, second];
