[first
// before comma
,

second];
---------- Options ----------
{}
---------- Output ----------
[
  first,

  // before comma
  second,
];

---------- Options ----------
{"printWidth":14}
---------- Output ----------
[
  first,

  // before comma
  second,
];

---------- Options ----------
{"printWidth":13}
---------- Output ----------
[
  first,

  // before comma
  second,
];

---------- Options ----------
{"printWidth":10}
---------- Output ----------
[
  first,

  // before comma
  second,
];

---------- Options ----------
{"printWidth":0}
---------- Output ----------
[
  first,

  // before comma
  second,
];

---------- Options ----------
{"semi":false}
---------- Output ----------
;[
  first,

  // before comma
  second,
]

---------- Options ----------
{"printWidth":10,"trailingComma":"none"}
---------- Output ----------
[
  first,

  // before comma
  second
];

---------- Options ----------
{"printWidth":10,"trailingComma":"es5"}
---------- Output ----------
[
  first,

  // before comma
  second,
];

---------- Options ----------
{"printWidth":10,"tabWidth":4,"useTabs":true}
---------- Output ----------
[
	first,

	// before comma
	second,
];

---------- Options ----------
{"endOfLine":"crlf","printWidth":10}
---------- Output ----------
[
  first,

  // before comma
  second,
];
