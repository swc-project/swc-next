(!first) in
  (second instanceof
    third);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(!first) in
	(second instanceof
		third);

---------- Options ----------
{"endOfLine":"crlf"}
