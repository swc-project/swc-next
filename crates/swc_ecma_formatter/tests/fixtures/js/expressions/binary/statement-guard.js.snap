---------- Input ----------
item;
(first + second) * third;
---------- Options ----------
{}
---------- Output ----------
item;
(first + second) * third;

---------- Options ----------
{"semi":false}
---------- Output ----------
item
;(first + second) * third

---------- Options ----------
{"printWidth":20}
---------- Output ----------
item;
(first + second) *
  third;

---------- Options ----------
{"printWidth":10}
---------- Output ----------
item;
(first +
  second) *
  third;

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
item;
(first + second) *
	third;

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
item;
(first + second) * third;

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
item;
(first + second) * third;
