---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
first | second ^ third & fourth;
---------- Options ----------
{}
---------- Output ----------
first | (second ^ (third & fourth));

---------- Options ----------
{"semi":false}
---------- Output ----------
first | (second ^ (third & fourth))

---------- Options ----------
{"printWidth":20}
---------- Output ----------
first |
  (second ^
    (third &
      fourth));

---------- Options ----------
{"printWidth":10}
---------- Output ----------
first |
  (second ^
    (third &
      fourth));

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
first |
	(second ^
		(third &
			fourth));

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
first | (second ^ (third & fourth));

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
first | (second ^ (third & fourth));
