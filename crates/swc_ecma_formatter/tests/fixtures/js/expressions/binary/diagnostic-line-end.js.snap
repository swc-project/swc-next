---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
(// @ts-ignore
first +
second + third);
---------- Options ----------
{}
---------- Output ----------
(// @ts-ignore
  first +
    second +
    third
);

---------- Options ----------
{"semi":false}
---------- Output ----------
;(// @ts-ignore
  first +
    second +
    third
)

---------- Options ----------
{"printWidth":20}
---------- Output ----------
(// @ts-ignore
  first +
    second +
    third
);

---------- Options ----------
{"printWidth":10}
---------- Output ----------
(// @ts-ignore
  first +
    second +
    third
);

---------- Options ----------
{"printWidth":20,"tabWidth":4,"useTabs":true}
---------- Output ----------
(// @ts-ignore
	first +
		second +
		third
);

---------- Options ----------
{"endOfLine":"crlf"}
---------- Output ----------
(// @ts-ignore
  first +
    second +
    third
);

---------- Options ----------
{"singleQuote":true}
---------- Output ----------
(// @ts-ignore
  first +
    second +
    third
);
