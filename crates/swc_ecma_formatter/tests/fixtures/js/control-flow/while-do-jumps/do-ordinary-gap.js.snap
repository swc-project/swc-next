---
source: crates/swc_ecma_formatter/tests/fixtures/mod.rs
---
---------- Input ----------
do {call(1+2);} /* boundary */ while (/* condition */ a+b);
---------- Options ----------
{"printWidth":80}
---------- Output ----------
do {
  call(1 + 2);
} /* boundary */ while (/* condition */ a + b);

---------- Options ----------
{"printWidth":20}
---------- Output ----------
do {
  call(1 + 2);
} /* boundary */ while (
  /* condition */ a +
  b
);

---------- Options ----------
{"printWidth":80,"semi":false}
---------- Output ----------
do {
  call(1 + 2)
} /* boundary */ while (/* condition */ a + b)

---------- Options ----------
{"printWidth":20,"semi":false}
---------- Output ----------
do {
  call(1 + 2)
} /* boundary */ while (
  /* condition */ a +
  b
)

---------- Options ----------
{"printWidth":20,"useTabs":true}
---------- Output ----------
do {
	call(1 + 2);
} /* boundary */ while (
	/* condition */ a +
	b
);

---------- Options ----------
{"endOfLine":"crlf","printWidth":40}
---------- Output ----------
do {
  call(1 + 2);
} /* boundary */ while (
  /* condition */ a + b
);
