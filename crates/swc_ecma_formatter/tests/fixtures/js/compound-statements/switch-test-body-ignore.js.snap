---------- Input ----------
switch (x) {case /* prettier-ignore */ 1+2: /* prettier-ignore */ f( 1 );}
---------- Options ----------
{}
---------- Output ----------
switch (x) {
  case /* prettier-ignore */ 1+2: /* prettier-ignore */ f( 1 );
}

---------- Options ----------
{"printWidth":20,"semi":false}
