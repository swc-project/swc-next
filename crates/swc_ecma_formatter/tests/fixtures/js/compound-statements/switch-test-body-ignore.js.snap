switch (x) {
	case /* prettier-ignore */ 1+2: /* prettier-ignore */ f( 1 );
}

---------- Options ----------
{"endOfLine":"crlf","printWidth":1,"semi":false}
---------- Output ----------
switch (
  x
) {
  case /* prettier-ignore */ 1+2: /* prettier-ignore */ f( 1 )
}
