switch (x) {
	default: // prettier-ignore
	{
		f( 1 );
	}
}

---------- Options ----------
{"endOfLine":"crlf","printWidth":1,"semi":false}
---------- Output ----------
switch (
  x
) {
  default: // prettier-ignore
  {
    f( 1 )
  }
}
