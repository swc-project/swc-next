---------- Input ----------
function f(value : {key: number} = /* prettier-ignore */ {key  : 1}) { return value; }
---------- Options ----------
{"printWidth":80}
---------- Output ----------
function f(value: { key: number } = /* prettier-ignore */ {key  : 1}) {
  return value;
}

---------- Options ----------
{"printWidth":20}
---------- Output ----------
function f(
  value: {
    key: number;
  } = /* prettier-ignore */ {key  : 1},
) {
  return value;
}

---------- Options ----------
{"printWidth":1,"semi":false}
---------- Output ----------
function f(
  value: {
    key: number
  } = /* prettier-ignore */ {key  : 1},
) {
  return value
}

---------- Options ----------
{"endOfLine":"crlf","printWidth":20,"useTabs":true}
---------- Output ----------
function f(
	value: {
		key: number;
	} = /* prettier-ignore */ {key  : 1},
) {
	return value;
}
