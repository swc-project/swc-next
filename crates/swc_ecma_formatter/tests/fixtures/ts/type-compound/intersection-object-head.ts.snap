---------- Input ----------
type A = {left:string} &
/* lead */
{right:number};
---------- Options ----------
{"printWidth":80}
---------- Output ----------
type A = { left: string } &
/* lead */
{ right: number };

---------- Options ----------
{"printWidth":20}
---------- Output ----------
type A = {
  left: string;
} &
/* lead */
{ right: number };

---------- Options ----------
{"printWidth":1,"semi":false}
---------- Output ----------
type A =
  {
    left: string
  } &
  /* lead */
  {
    right: number
  }

---------- Options ----------
{"endOfLine":"crlf","printWidth":20,"trailingComma":"none","useTabs":true}
---------- Output ----------
type A = {
	left: string;
} &
/* lead */
{ right: number };
