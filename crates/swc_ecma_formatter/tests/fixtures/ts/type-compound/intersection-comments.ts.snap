---------- Input ----------
type Combined=A /*one*/&/*two*/ B&C;
---------- Options ----------
{"printWidth":80}
---------- Output ----------
type Combined = A /*one*/ & /*two*/ B & C;

---------- Options ----------
{"printWidth":20}
---------- Output ----------
type Combined =
  A /*one*/ &
    /*two*/ B &
    C;

---------- Options ----------
{"printWidth":1,"semi":false}
---------- Output ----------
type Combined =
  A /*one*/ &
    /*two*/ B &
    C

---------- Options ----------
{"endOfLine":"crlf","printWidth":20,"trailingComma":"none","useTabs":true}
