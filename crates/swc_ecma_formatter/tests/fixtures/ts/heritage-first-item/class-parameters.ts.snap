---------- Input ----------
class Subject<T> extends Base implements
/* head */
First<T>, Second<T> {}
---------- Options ----------
{"printWidth":80}
---------- Output ----------
class Subject<T>
  extends Base
  implements
    /* head */
    First<T>,
    Second<T> {}

---------- Options ----------
{"printWidth":20,"semi":false}
