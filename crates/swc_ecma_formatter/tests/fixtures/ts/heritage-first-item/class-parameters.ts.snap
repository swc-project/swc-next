class Subject<T>
  extends Base
  implements
    /* head */
    First<T>,
    Second<T> {}

---------- Options ----------
{"endOfLine":"crlf","printWidth":100,"useTabs":true}
---------- Output ----------
class Subject<T>
	extends Base
	implements
		/* head */
