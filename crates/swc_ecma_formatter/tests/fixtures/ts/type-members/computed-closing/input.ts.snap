---------- Input ----------
type T = { [get]; foo(): X };
---------- Options ----------
{"printWidth":80}
---------- Output ----------
type T = { [get]; foo(): X };

---------- Options ----------
{"printWidth":20}
---------- Output ----------
type T = {
  [get];
  foo(): X;
};

---------- Options ----------
{"printWidth":1,"semi":false}
