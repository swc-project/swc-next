---------- Input ----------
class C { method<T>(value: T): T; method<T>(value: T): T { return value; } }
---------- Options ----------
{"printWidth":80}
---------- Output ----------
class C {
  method<T>(value: T): T;
  method<T>(value: T): T {
    return value;
  }
}

---------- Options ----------
{"printWidth":20}
---------- Output ----------
class C {
  method<T>(
    value: T,
  ): T;
  method<T>(
    value: T,
  ): T {
    return value;
  }
}

---------- Options ----------
{"arrowParens":"avoid","printWidth":20,"semi":false,"trailingComma":"none"}
---------- Output ----------
class C {
  method<T>(
    value: T
  ): T
  method<T>(
    value: T
  ): T {
    return value
  }
}

---------- Options ----------
{"endOfLine":"crlf","printWidth":20}
---------- Output ----------
class C {
  method<T>(
    value: T,
  ): T;
  method<T>(
    value: T,
  ): T {
    return value;
  }
}
