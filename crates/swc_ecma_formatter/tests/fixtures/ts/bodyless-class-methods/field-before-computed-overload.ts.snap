---------- Input ----------
const key = "method"; class C { value = 1; [key](input: number): number; [key](input: number): number { return input + this.value; } }
---------- Options ----------
{"printWidth":80}
---------- Output ----------
const key = "method";
class C {
  value = 1;
  [key](input: number): number;
  [key](input: number): number {
    return input + this.value;
  }
}

---------- Options ----------
{"printWidth":20}
---------- Output ----------
const key =
  "method";
class C {
  value = 1;
  [key](
    input: number,
  ): number;
  [key](
    input: number,
  ): number {
    return (
      input +
      this.value
    );
  }
}

