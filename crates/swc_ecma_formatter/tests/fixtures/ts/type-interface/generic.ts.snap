---------- Input ----------
interface T<in A,out B extends A=A>{value:B}
---------- Options ----------
{"printWidth":80}
---------- Output ----------
interface T<in A, out B extends A = A> {
  value: B;
}

---------- Options ----------
{"printWidth":20}
---------- Output ----------
interface T<
  in A,
  out B extends A =
    A,
> {
  value: B;
}

---------- Options ----------
{"printWidth":1,"semi":false}
---------- Output ----------
interface T<
  in A,
  out B extends
    A =
    A,
> {
  value: B
}

---------- Options ----------
{"endOfLine":"crlf","printWidth":20,"useTabs":true}
---------- Output ----------
interface T<
	in A,
	out B extends A =
		A,
> {
	value: B;
}
