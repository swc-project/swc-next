---------- Input ----------
left << <T>/value/.test(input);
---------- Options ----------
{"printWidth":80}
---------- Output ----------
left << ((<T>/value/.test(input)));

---------- Options ----------
{"printWidth":20}
---------- Output ----------
left <<
  ((<T>/value/.test(
    input,
  )));

---------- Options ----------
{"printWidth":1,"semi":false}
---------- Output ----------
left <<
  ((<
    T
  >/value/.test(
    input,
  )))

---------- Options ----------
{"endOfLine":"crlf","printWidth":20,"useTabs":true}
---------- Output ----------
left <<
	((<T>/value/.test(
		input,
	)));
