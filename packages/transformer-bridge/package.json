      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@swc-next/decoder": "workspace:*",
    "@swc-next/encoder": "workspace:*"
  }
}
