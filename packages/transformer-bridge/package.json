{
  "name": "@swc-next/transformer-bridge",
  "version": "0.6.1",
  "description": "JavaScript glue for SWC Next source transformation bindings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "packages/transformer-bridge"
  },
  "main": "index.js",
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
