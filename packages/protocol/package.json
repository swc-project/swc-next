{
  "name": "@swc-next/protocol",
  "version": "0.8.1",
  "description": "Shared source for SWC Next internal JavaScript transport protocols",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ast/encode": {
      "types": "./ast/encode.d.ts",
      "import": "./ast/encode.js"
    },
    "./ast/decode": {
      "types": "./ast/decode.d.ts",
      "import": "./ast/decode.js"
    },
    "./parser": {
      "types": "./parser.d.ts",
      "import": "./parser.js"
    },
    "./generator": {
      "types": "./generator.d.ts",
      "import": "./generator.js"
    },
    "./transform": {
      "types": "./transform.d.ts",
      "import": "./transform.js"
    },
    "./source": {
      "types": "./source.d.ts",
      "import": "./source.js"
    },
    "./output": {
      "types": "./output.d.ts",
      "import": "./output.js"
    },
    "./formatter": {
      "types": "./formatter.d.ts",
      "import": "./formatter.js"
    },
    "./document": {
      "types": "./document.d.ts",
      "import": "./document.js"
    },
    "./plugins": {
      "import": "./plugins.js"
    }
  },
  "files": [
    "ast",
    "buffer.js",
    "document.d.ts",
    "document.js",
    "formatter.d.ts",
    "formatter.js",
    "generator.d.ts",
    "generator.js",
    "output.d.ts",
    "output.js",
    "parser.d.ts",
    "parser.js",
    "source.d.ts",
    "source.js",
    "transform.d.ts",
    "transform.js",
    "README.md",
    "plugins.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@swc-next/types": "workspace:*",
    "@swc-next/walker": "workspace:*"
  }
}
