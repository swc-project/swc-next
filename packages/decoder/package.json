{
  "name": "@swc-next/decoder",
  "version": "0.6.1",
  "description": "Decode SWC Next native parser output into ESTree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "packages/decoder"
  },
  "main": "index.js",
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./transform": {
      "types": "./transform.d.ts",
      "import": "./transform.js"
    },
    "./options": {
      "types": "./options.d.ts",
      "import": "./options.js"
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "decode-js.js",
    "decode-ts.js",
    "README.md",
    "transform.js",
    "transform.d.ts",
    "options.js",
    "options.d.ts",
    "diagnostics.js",
    "utf8.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ast",
    "estree",
    "javascript",
    "swc",
    "typescript"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@swc-next/encoder": "workspace:*",
    "@swc-next/types": "workspace:*"
  }
}
