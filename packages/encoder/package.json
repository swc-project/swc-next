{
  "name": "@swc-next/encoder",
  "version": "0.4.0",
  "description": "Encode ESTree programs for SWC Next native crates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "packages/encoder"
  },
  "main": "index.js",
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
