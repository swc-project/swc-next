    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "encode-js.js",
    "encode-ts.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ast",
    "estree",
    "javascript",
    "swc",
    "typescript"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@swc-next/types": "workspace:*"
  }
}
