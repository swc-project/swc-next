{
  "name": "@swc-next/walker",
  "version": "0.8.1",
  "description": "Synchronous ESTree traversal and editing for JavaScript and TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "packages/walker"
  },
  "main": "./dist/index.js",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build:js": "pnpm -w exec rslib build --lib walker",
    "prepack": "pnpm build:js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ast",
    "estree",
    "javascript",
    "swc",
    "typescript",
    "walker"
  ],
  "license": "Apache-2.0"
}
