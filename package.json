{
  "name": "swc-next",
  "version": "0.3.2",
  "private": true,
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm --filter \"./npm/*\" --workspace-concurrency=1 --if-present build",
    "build:wasm": "pnpm --filter \"./npm/*\" --workspace-concurrency=1 --if-present build:wasm",
    "build:browser": "pnpm --filter @swc-next/core-browser build:browser",
    "test": "pnpm --filter @swc-next/core test",
    "test:wasm": "pnpm --filter @swc-next/core test:wasm",
    "test:browser": "pnpm --filter @swc-next/core-browser test:browser",
    "test:conformance": "pnpm --filter @swc-next/core test:conformance",
    "test:codec": "pnpm --filter @swc-next/core test:codec",
    "dev:playground": "pnpm --filter playground dev",
    "build:playground": "pnpm --filter playground build",
    "dev:docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build",
    "check:docs": "pnpm --filter docs check"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@rstest/browser": "catalog:",
    "@rstest/core": "catalog:",
    "cac": "catalog:",
    "playwright": "catalog:"
  }
}
