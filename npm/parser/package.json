{
  "name": "@swc-next/parser",
  "version": "0.4.0",
  "description": "The focused JavaScript and TypeScript parser for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/parser"
  },
  "main": "src-js/index.js",
  "type": "module",
  "types": "./src-js/index.d.ts",
  "exports": {
    ".": {
      "import": "./src-js/index.js",
      "types": "./src-js/index.d.ts"
    }
  },
  "files": [
    "src-js/binding.d.ts",
    "src-js/binding.js",
    "src-js/index.d.ts",
    "src-js/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --platform --no-js --dts binding.d.ts --output-dir src-js",
    "build:wasm": "cargo run --quiet --locked -p bridge_cli -- build parser --output-dir src-js"
  },
  "keywords": [
    "ast",
    "javascript",
    "parser",
    "swc",
    "typescript"
  ],
  "license": "Apache-2.0",
  "napi": {
    "constEnum": false,
    "binaryName": "swc-next-parser",
    "packageName": "@swc-next/parser-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "dependencies": {
    "@swc-next/decoder": "workspace:*",
    "@swc-next/types": "workspace:*"
  },
  "wasm": {
    "binaryName": "swc-next-parser",
    "packageName": "@swc-next/parser-binding-wasm"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:"
  }
}
