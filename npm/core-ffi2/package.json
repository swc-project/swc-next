{
  "name": "@swc-next/core-ffi2",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src-js/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./src-js/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./binding": {
      "types": "./src-js/binding.d.ts",
      "default": "./dist/binding.js"
    }
  },
  "imports": {
    "#protocol/*": "./src-js/protocol/*.ts"
  },
  "scripts": {
    "build:js": "pnpm -w exec rslib build --config npm/core-ffi2/rslib.config.js",
    "build:ffi2": "pnpm build:js && napi build --no-js --dts ../src-js/binding.d.ts --output-dir dist",
    "build:wasm:ffi2": "pnpm build:js && cargo run --quiet --locked -p bridge_cli -- build core-ffi2 --output-dir dist",
    "test": "pnpm build:js && node --test \"test/!(walk*).test.js\" && rstest run --include \"test/walk*.test.js\"",
    "test:wasm": "cross-env NAPI_RS_FORCE_WASI=error pnpm test"
  },
  "napi": {
    "binaryName": "swc-next-core-ffi2",
    "packageName": "@swc-next/core-ffi2-binding"
  },
  "wasm": {
    "binaryName": "swc-next-core-ffi2"
  },
  "dependencies": {
    "@swc-next/protocol": "workspace:*",
    "@swc-next/types": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@rstest/core": "catalog:",
    "@swc-next/core": "workspace:*",
    "cross-env": "catalog:"
  }
}
