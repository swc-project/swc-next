{
  "name": "@swc-next/formatter",
  "version": "0.3.0",
  "description": "Internal SWCFMT document transport for the SWC Prettier plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/formatter"
  },
  "main": "src-js/index.js",
  "type": "module",
  "types": "./src-js/index.d.ts",
  "exports": {
    ".": {
      "import": "./src-js/index.js",
      "types": "./src-js/index.d.ts"
    }
  },
  "files": [
    "src-js/binding.d.ts",
    "src-js/binding.js",
    "src-js/index.d.ts",
    "src-js/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --platform --no-js --dts binding.d.ts --output-dir src-js",
    "build:test": "napi build --features test-native --output-dir test/binding",
    "build:wasm": "cargo run --quiet --locked -p bridge_cli -- build formatter --output-dir src-js"
  },
  "keywords": [
    "formatter",
    "prettier",
    "swc"
  ],
  "license": "Apache-2.0",
  "napi": {
    "binaryName": "swc-next-formatter",
    "packageName": "@swc-next/formatter-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "wasm": {
    "binaryName": "swc-next-formatter",
    "packageName": "@swc-next/formatter-binding-wasm"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@types/node": "catalog:"
  }
}
