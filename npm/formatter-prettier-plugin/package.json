{
  "name": "@swc-next/formatter-prettier-plugin",
  "version": "0.8.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@swc-next/formatter-js": "workspace:*"
  },
  "peerDependencies": {
    "prettier": "catalog:"
  },
  "description": "Experimental and unstable JavaScript and TypeScript formatting through SWC and Prettier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/formatter-prettier-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:js": "pnpm -w exec rslib build --lib formatter-prettier-plugin",
    "test": "pnpm -w build:js && node --test test/markdown.test.js && node test/prettier-plugin-conformance.js",
    "test:wasm": "cross-env NAPI_RS_FORCE_WASI=error pnpm test",
    "prepack": "pnpm build:js"
  },
  "devDependencies": {
    "@swc-next/formatter": "workspace:*",
    "@swc-next/protocol": "workspace:*",
    "cross-env": "catalog:",
    "prettier": "catalog:"
  }
}
