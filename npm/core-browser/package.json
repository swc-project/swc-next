{
  "name": "@swc-next/core-browser",
  "version": "0.1.3",
  "description": "The browser WebAssembly API for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/core-browser"
  },
  "main": "src-js/index.js",
  "type": "module",
  "types": "./src-js/index.d.ts",
  "exports": {
    ".": {
      "types": "./src-js/index.d.ts",
      "import": "./src-js/index.js",
      "default": "./src-js/index.js"
    }
  },
  "files": [
    "src-js/binding.d.ts",
    "src-js/index.d.ts",
    "src-js/index.js",
    "src-js/swc-next-core.bridge.mjs",
    "src-js/swc-next-core.browser.mjs",
    "src-js/swc-next-core.runtime.mjs",
    "src-js/swc-next-core.wasm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:browser": "node ../../scripts/build-wasm.mjs core",
    "test:browser": "rstest run --include smoke.test.js --browser --browser.headless"
  },
  "dependencies": {
    "@swc-next/decoder": "workspace:*",
    "@swc-next/encoder": "workspace:*"
  },
  "keywords": [
    "ast",
    "javascript",
    "swc",
    "typescript",
    "wasm",
    "webassembly"
  ],
  "author": "",
  "license": "Apache-2.0"
}
