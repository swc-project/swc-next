{
  "name": "@swc-next/core-browser",
  "version": "0.8.1",
  "description": "The browser WebAssembly API for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/core-browser"
  },
  "main": "dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/binding.d.ts",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/swc-next-core.bridge.mjs",
    "dist/swc-next-core.browser.mjs",
    "dist/swc-next-core.runtime.mjs",
    "dist/swc-next-core.wasm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:js": "pnpm -w exec rslib build --lib core-browser",
    "build:browser": "cargo run --quiet --locked --manifest-path ../../Cargo.toml -p bridge_cli -- build core --output-dir dist",
    "test:browser": "pnpm build:js && rstest run --include smoke.test.js --browser --browser.headless",
    "prepack": "pnpm build:js",
    "prepare:browser": "node ../../scripts/wasm-package/cli.mjs prepare-browser"
  },
  "dependencies": {
    "@swc-next/types": "workspace:*"
  },
  "keywords": [
    "ast",
    "javascript",
    "swc",
    "typescript",
    "wasm",
    "webassembly"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@swc-next/protocol": "workspace:*"
  }
}
