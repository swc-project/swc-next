{
  "name": "@swc-next/core",
  "version": "0.1.3",
  "description": "The extensible Node.js API for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/core"
  },
  "main": "src-js/index.js",
  "type": "module",
  "types": "./src-js/index.d.ts",
  "exports": {
    ".": {
      "import": "./src-js/index.js",
      "types": "./src-js/index.d.ts"
    }
  },
  "files": [
    "src-js/binding.d.ts",
    "src-js/binding.js",
    "src-js/index.d.ts",
    "src-js/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --platform --no-js --dts binding.d.ts --output-dir src-js",
    "build:wasm": "node ../../scripts/build-wasm.mjs core --output-dir src-js",
    "conformance": "pnpm build --release && node ./test/estree-conformance.ts",
    "test": "node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "napi": {
    "binaryName": "swc-next-core",
    "packageName": "@swc-next/core-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "dependencies": {
    "@swc-next/decoder": "workspace:*",
    "@swc-next/encoder": "workspace:*"
  },
  "wasm": {
    "target": "wasm32-unknown-unknown",
    "binaryName": "swc-next-core",
    "packageName": "@swc-next/core-binding-wasm"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "oxc-parser": "catalog:",
    "tinybench": "catalog:",
    "tinypool": "catalog:",
    "typescript": "catalog:",
    "yuku-parser": "catalog:"
  }
}
