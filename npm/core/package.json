{
  "name": "@swc-next/core",
  "version": "0.4.0",
  "description": "The extensible Node.js API for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/core"
  },
  "main": "src-js/index.js",
  "type": "module",
  "types": "./src-js/index.d.ts",
  "exports": {
    ".": {
      "import": "./src-js/index.js",
      "types": "./src-js/index.d.ts"
    }
  },
  "files": [
    "src-js/binding.d.ts",
    "src-js/binding.js",
    "src-js/index.d.ts",
    "src-js/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --platform --no-js --dts binding.d.ts --output-dir src-js",
    "build:wasm": "cargo run --quiet --locked -p bridge_cli -- build core --output-dir src-js",
    "test": "node --test test/*.test.js && pnpm test:walk",
    "test:walk": "rstest run --include \"test/walk/*.test.js\"",
    "test:wasm": "cross-env NAPI_RS_FORCE_WASI=error pnpm test",
    "test:conformance": "pnpm build --release && node ./test/estree-conformance.ts",
    "test:codec": "napi build --platform --release --features test-codec --esm --output-dir test/binding && node ./test/codec-conformance.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "napi": {
    "constEnum": false,
    "binaryName": "swc-next-core",
    "packageName": "@swc-next/core-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "dependencies": {
    "@swc-next/decoder": "workspace:*",
    "@swc-next/encoder": "workspace:*",
    "@swc-next/types": "workspace:*",
    "@swc-next/walker": "workspace:*"
  },
  "wasm": {
    "binaryName": "swc-next-core",
    "packageName": "@swc-next/core-binding-wasm"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@rstest/core": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "oxc-parser": "catalog:",
    "tinybench": "catalog:",
    "tinypool": "catalog:",
    "typescript": "catalog:",
    "yuku-parser": "catalog:"
  }
}
