{
  "name": "@swc-next/core-wasm",
  "version": "0.1.3",
  "description": "The portable WebAssembly API for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/core-wasm"
  },
  "main": "index.js",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "binding.d.ts",
    "index.d.ts",
    "index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "wasmBinding": "@swc-next/core-binding-wasm",
  "dependencies": {
    "@swc-next/decoder": "workspace:*",
    "@swc-next/encoder": "workspace:*"
  },
  "keywords": [
    "ast",
    "javascript",
    "swc",
    "typescript",
    "wasm",
    "webassembly"
  ],
  "author": "",
  "license": "Apache-2.0"
}
