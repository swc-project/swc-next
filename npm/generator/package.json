{
  "name": "@swc-next/generator",
  "version": "0.8.1",
  "description": "The focused JavaScript and TypeScript code generator for SWC Next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "npm/generator"
  },
  "main": "dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ffi2": {
      "types": "./dist/ffi2.d.ts",
      "import": "./dist/ffi2.js",
      "default": "./dist/ffi2.js"
    }
  },
  "files": [
    "dist/binding.d.ts",
    "dist/binding.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/ffi2.js",
    "dist/ffi2.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --platform --no-js --dts ../src-js/binding.d.ts --output-dir dist",
    "build:js": "pnpm --filter @swc-next/ast2 build && pnpm -w exec rslib build --lib generator --lib generator-ffi2",
    "build:wasm": "cargo run --quiet --locked -p bridge_cli -- build generator --output-dir dist",
    "prepack": "pnpm build:js"
  },
  "keywords": [
    "ast",
    "generator",
    "javascript",
    "swc",
    "typescript"
  ],
  "license": "Apache-2.0",
  "napi": {
    "constEnum": false,
    "binaryName": "swc-next-generator",
    "packageName": "@swc-next/generator-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "dependencies": {
    "@swc-next/types": "workspace:*",
    "@swc-next/ast2": "workspace:*"
  },
  "wasm": {
    "binaryName": "swc-next-generator",
    "packageName": "@swc-next/generator-binding-wasm"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@swc-next/protocol": "workspace:*",
    "@types/node": "catalog:"
  }
}
